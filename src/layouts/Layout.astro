---
import { site } from '../data/site';
import logoUrl from '../../assets/Logo cabinet libéral Version 3.svg?url';
import '../styles/global.css';
interface Props { title: string; description: string }
const { title, description } = Astro.props;
const links = [
  ['/', 'Accueil'],
  ['/qui-suis-je/', 'Qui suis-je'],
  ['/bilan-neuropsychologique/', 'Bilan neuropsychologique'],
  ['/tcc/', 'TCC'],
  ['/tarifs/', 'Tarifs'],
  ['/contact/', 'Contact'],
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#254d43" />
    <link rel="icon" type="image/svg+xml" href={logoUrl} />
    <title>{title} | {site.name}</title>
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="header">
      <a class="brand brand-with-logo" href="/" aria-label={`${site.name}, accueil`}>
        <img class="brand-logo" src={logoUrl} width="64" height="64" alt="" />
        <div class="brand-copy">{site.name}<span>{site.profession}</span></div>
      </a>
      <nav aria-label="Navigation principale">
        {links.map(([href, label]) => <a href={href} aria-current={currentPath === (href.replace(/\/$/, '') || '/') ? 'page' : undefined}>{label}</a>)}
      </nav>
      <a class="button header-booking" href="/prendre-rendez-vous/" aria-current={currentPath === '/prendre-rendez-vous' ? 'page' : undefined}>Prendre rendez-vous <span aria-hidden="true">↗</span></a>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="footer">
      <a class="brand brand-with-logo" href="/" aria-label={`${site.name}, accueil`}>
        <img class="brand-logo" src={logoUrl} width="56" height="56" alt="" loading="lazy" />
        <div class="brand-copy">{site.name}<span>{site.profession}</span></div>
      </a>
      <p>Un espace pour vous, à votre rythme.</p>
      <a href="/contact/">Contact & informations pratiques <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
